# Sanity CMS — powers the portfolio project pages.
# Both are PUBLIC_ prefixed because the client queries the Sanity CDN directly.
# Find these in the Sanity project settings, or in studio-liveroof-ontario/sanity.cli.ts.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave blank to disable analytics entirely — nothing is loaded without it,
# which is what keeps local dev and preview deploys untracked.
PUBLIC_GA_MEASUREMENT_ID=
