---
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { organizationSchema, websiteSchema } from '../lib/structuredData';

interface Props {
  title: string;
  /** Meta + Open Graph description. Falls back to the company boilerplate. */
  description?: string;
  /** Social share image, site-root-relative. Resolved to an absolute URL. */
  image?: string;
  /** Set on pages that should stay out of search results. */
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Canada’s largest producer of pre-vegetated modular green roof systems — grown on our Ontario nursery farm and delivered to the roof fully mature.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/images/wildflower-roof-cityview.jpg',
  noindex = false,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs; both are required for
// canonical + og:url to be absolute, which is what crawlers and social
// unfurlers need.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// The organisation graph belongs on one page, not all 92 — other pages point
// at it by @id. The homepage is the conventional home for it.
const isHomepage = Astro.url.pathname === '/';
const siteJsonLd = isHomepage
  ? JSON.stringify([organizationSchema(), websiteSchema()])
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3a7d44" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LiveRoof Ontario" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_CA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Loaded with media="print" so it does not block first paint on a
        cross-origin round trip (~155ms measured). A script below flips it to
        media="all" once fetched; <noscript> covers the no-JS case. The URL
        already carries display=swap, so text paints in the fallback face and
        swaps when the webfont lands. */}
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap"
      rel="stylesheet"
      media="print"
      data-font-css
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {siteJsonLd && <script is:inline type="application/ld+json" set:html={siteJsonLd} />}

    <Analytics />
  </head>
  <body>
    {/* First tab stop: lets keyboard users jump the ~25-item nav. */}
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <TopBar />
    <Header />

    {/* tabindex="-1" so the skip link above moves focus here, not just scroll. */}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <ConsentBanner />

    {/* External link interstitial */}
    <div id="ext-modal" role="dialog" aria-modal="true" aria-labelledby="ext-modal-title" style="display:none">
      <div id="ext-modal-backdrop"></div>
      <div id="ext-modal-box">
        <div id="ext-modal-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </div>
        <h2 id="ext-modal-title">You are leaving LiveRoof Ontario</h2>
        <p id="ext-modal-body">
          You are now leaving <strong>liveroofontario.ca</strong> and entering an external site.
        </p>
        <div id="ext-modal-actions">
          <button id="ext-modal-cancel">Stay on this site</button>
          <a id="ext-modal-continue" href="#" target="_blank" rel="noopener noreferrer">Continue</a>
        </div>
      </div>
    </div>

    <script>
      // Apply the webfont stylesheet once it has loaded. It ships as
      // media="print" so it never blocks first paint; flipping to "all" here
      // avoids an inline onload= handler, keeping the pages CSP-friendly.
      (function () {
        const fontCss = document.querySelector<HTMLLinkElement>('link[data-font-css]');
        if (!fontCss) return;
        const apply = () => { fontCss.media = 'all'; };
        // sheet is non-null once the stylesheet has finished loading
        if (fontCss.sheet) apply();
        else fontCss.addEventListener('load', apply, { once: true });
      })();

      // Logo fallback for Header/Footer. Replaces inline onerror= handlers so
      // the pages stay CSP-friendly, and matches the fallback by data attribute
      // rather than nextElementSibling.
      (function () {
        function showFallback(img: HTMLImageElement) {
          const fallback = img.parentElement?.querySelector<HTMLElement>('[data-logo-fallback]');
          if (!fallback) return;
          img.style.display = 'none';
          fallback.style.display = fallback.dataset.logoFallback || 'block';
        }

        document.querySelectorAll<HTMLImageElement>('img[data-logo]').forEach((img) => {
          img.addEventListener('error', () => showFallback(img));
          // This script is deferred, so a fast failure can happen before the
          // listener is attached; catch that case on startup.
          if (img.complete && img.naturalWidth === 0) showFallback(img);
        });
      })();

      (function () {
        const modal = document.getElementById('ext-modal') as HTMLElement;
        const backdrop = document.getElementById('ext-modal-backdrop') as HTMLElement;
        const cancelBtn = document.getElementById('ext-modal-cancel') as HTMLElement;
        const continueLink = document.getElementById('ext-modal-continue') as HTMLAnchorElement;
        const body = document.getElementById('ext-modal-body') as HTMLElement;

        // The link that opened the dialog, so focus can be restored on close.
        let lastTrigger: HTMLElement | null = null;

        const partners: Record<string, { domain: string; copy: string }> = {
          'liveroof.com': {
            domain: 'liveroof.com',
            copy: 'the LiveRoof Global website, where additional product information, technical resources, and specifications are hosted.',
          },
          'hydropavers.ca': {
            domain: 'hydropavers.ca',
            copy: 'the official hydroPAVERS® site, our partner for permeable paving and stormwater management products.',
          },
        };

        function matchPartner(href: string) {
          for (const key of Object.keys(partners)) {
            if (href.includes(key) && !href.includes('liveroofontario')) return partners[key];
          }
          return null;
        }

        function openModal(href: string, partner: { domain: string; copy: string }) {
          continueLink.href = href;
          continueLink.textContent = 'Continue to ' + partner.domain;
          body.innerHTML =
            'You are now leaving <strong>liveroofontario.ca</strong> and entering <strong>' +
            partner.domain + '</strong> — ' + partner.copy;
          modal.style.display = 'flex';
          // Background must not scroll behind the dialog.
          document.body.style.overflow = 'hidden';
          cancelBtn.focus();
        }

        function closeModal() {
          modal.style.display = 'none';
          document.body.style.overflow = '';
          continueLink.href = '#';
          // Return focus to the link that opened the dialog, not the top of
          // the page. Without this a keyboard user loses their place.
          if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
          lastTrigger = null;
        }

        const isOpen = () => modal.style.display === 'flex';

        // The dialog is aria-modal, which tells assistive tech the rest of the
        // page is inert — so focus has to actually be kept inside it.
        function trapFocus(e: KeyboardEvent) {
          if (e.key !== 'Tab' || !isOpen()) return;
          const focusable = [cancelBtn, continueLink].filter(
            (el) => el && !(el as HTMLButtonElement).disabled,
          ) as HTMLElement[];
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          const active = document.activeElement;

          if (e.shiftKey && (active === first || !modal.contains(active))) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && (active === last || !modal.contains(active))) {
            e.preventDefault();
            first.focus();
          }
        }

        document.addEventListener('click', function (e) {
          const anchor = (e.target as Element)?.closest('a');
          if (!anchor || anchor.id === 'ext-modal-continue') return;
          const href = (anchor as HTMLAnchorElement).href || '';
          const partner = matchPartner(href);
          if (partner) {
            e.preventDefault();
            lastTrigger = anchor as HTMLElement;
            openModal(href, partner);
          }
        });

        cancelBtn.addEventListener('click', closeModal);
        continueLink.addEventListener('click', function () {
          // Navigating away: drop the trap without stealing focus back.
          modal.style.display = 'none';
          document.body.style.overflow = '';
          lastTrigger = null;
        });
        backdrop.addEventListener('click', closeModal);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && isOpen()) closeModal();
          trapFocus(e);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
