---
interface Props {
  number: string;
  format?: 'paren' | 'dash';
  class?: string;
  ariaLabel?: string;
}

const { number, format = 'paren', class: className = '', ariaLabel } = Astro.props;

const digits = number.replace(/\D/g, '');

let a = '', b = '', c = '', d = '';
if (digits.length === 11) {
  a = digits.slice(0, 1);
  b = digits.slice(1, 4);
  c = digits.slice(4, 7);
  d = digits.slice(7, 11);
} else if (digits.length === 10) {
  b = digits.slice(0, 3);
  c = digits.slice(3, 6);
  d = digits.slice(6, 10);
} else {
  b = digits;
}

const masked = format === 'dash'
  ? (a ? '•-•••-•••-••••' : '•••-•••-••••')
  : '(•••) •••-••••';
---
<button
  type="button"
  class={`phone-reveal ${className}`}
  data-format={format}
  data-a={a}
  data-b={b}
  data-c={c}
  data-d={d}
  aria-label={ariaLabel ?? 'Click to reveal phone number'}
>
  <span class="phone-reveal-text">{masked}</span>
  {/* Hidden by CSS once data-revealed="true" — see the rule below. */}
  <span class="phone-reveal-hint" aria-hidden="true"> &middot; tap to reveal</span>
</button>

<style>
  .phone-reveal {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    /* WCAG 2.5.8: 24x24 minimum target size */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: inherit;
    text-decoration: inherit;
  }
  .phone-reveal:hover .phone-reveal-text { text-decoration: underline; }
  .phone-reveal-hint {
    font-size: 0.7em;
    opacity: 0.55;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .phone-reveal[data-revealed="true"] .phone-reveal-hint { display: none; }
</style>

<!-- Not is:inline: bundling keeps it out of the HTML (it was emitted once per
     instance, ~2.5 KB per page) and lets a CSP use script-src 'self' with no
     per-build hash. -->
<script>
  // Astro emits a component's script once per page no matter how many
  // instances render, so this module runs exactly once — no global guard
  // needed. The number is split across data attributes and assembled here so
  // it never appears in the served HTML for scrapers to harvest.
  (function () {
    function format(btn: HTMLElement): string {
      const a = btn.dataset.a || '';
      const b = btn.dataset.b || '';
      const c = btn.dataset.c || '';
      const d = btn.dataset.d || '';
      if ((btn.dataset.format || 'paren') === 'dash') {
        return (a ? a + '-' : '') + b + '-' + c + '-' + d;
      }
      return '(' + b + ') ' + c + '-' + d;
    }
    function tel(btn: HTMLElement): string {
      return '+' + (btn.dataset.a || '1') + (btn.dataset.b || '') + (btn.dataset.c || '') + (btn.dataset.d || '');
    }

    document.addEventListener('click', function (e) {
      const btn = (e.target as Element | null)?.closest<HTMLElement>('.phone-reveal');
      if (!btn) return;
      if (btn.dataset.revealed === 'true') {
        e.preventDefault();
        window.location.href = tel(btn);
        return;
      }
      e.preventDefault();
      const span = btn.querySelector('.phone-reveal-text');
      if (span) span.textContent = format(btn);
      btn.dataset.revealed = 'true';
      btn.setAttribute('aria-label', 'Call ' + format(btn));
    });
  })();
</script>
