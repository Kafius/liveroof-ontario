---
// Google Analytics 4.
//
// The measurement ID comes from PUBLIC_GA_MEASUREMENT_ID so it is not baked
// into the repo and can differ per environment. With it unset nothing is
// loaded, so local dev and preview deploys stay untracked by default.
//
// Google's copy-paste snippet puts the dataLayer bootstrap in an inline
// <script>, which the CSP in vercel.json blocks (script-src 'self'). The
// bootstrap lives in the bundled <script> at the bottom instead; Vite
// substitutes import.meta.env.PUBLIC_* at build time, so the ID still reaches
// the client without an inline block.
//
// Nothing is rendered from the frontmatter: the gtag.js loader is deliberately
// NOT a markup <script>. Consent Mode requires the 'default' command to be
// queued before gtag.js evaluates, and an async tag in the head can win that
// race against a deferred module — which let GA write _ga cookies before
// consent was declared. The script below injects the loader after the defaults
// are queued, which makes the ordering deterministic.
---

<script>
  // Bundled (not is:inline) so script-src 'self' covers it.
  const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

  if (measurementId) {
    const dataLayer = ((window as any).dataLayer = (window as any).dataLayer || []);
    // gtag pushes `arguments` verbatim — an array, not a spread — so the
    // classic function form is required here.
    function gtag(..._args: unknown[]) {
      // eslint-disable-next-line prefer-rest-params
      dataLayer.push(arguments);
    }

    // Consent Mode v2. Everything starts denied, so GA cannot write cookies
    // before the visitor chooses. ConsentBanner.astro sends the 'update' once
    // they do, and replays a stored choice on later visits. This must be
    // queued before 'config', which is why it lives here rather than in the
    // banner.
    const stored = (() => {
      try {
        return localStorage.getItem('lr-consent');
      } catch {
        return null; // Safari private mode and similar
      }
    })();
    const granted = stored === 'granted' ? 'granted' : 'denied';

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: granted,
      wait_for_update: 500,
    });

    gtag('js', new Date());
    gtag('config', measurementId, { anonymize_ip: true });

    // Only now load gtag.js, so it sees the consent defaults already queued in
    // dataLayer. Injecting it here rather than via a markup <script> is what
    // makes that ordering deterministic.
    const loader = document.createElement('script');
    loader.async = true;
    loader.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(loader);
  }
</script>
