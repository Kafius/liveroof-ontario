---
interface Photo {
  image?: { asset?: { url?: string } };
  caption?: string;
  isMain?: boolean;
}

interface Props {
  photos: Photo[];
  name: string;
}

const { photos, name } = Astro.props as Props;

// Only photos that actually resolved to an asset URL can be shown.
const slides = (photos ?? []).filter(p => p?.image?.asset?.url);
const multiple = slides.length > 1;
---

{slides.length === 0 ? (
  <div class="aspect-[4/3] md:aspect-[16/10] bg-mid rounded-2xl overflow-hidden">
    <div class="photo-placeholder h-full rounded-none">
      <svg width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="m6 21 5.5-7 3.5 4 2.5-3L21 21" />
      </svg>
      <span>Photos coming soon</span>
    </div>
  </div>
) : (
  <div
    class="project-carousel"
    data-carousel
    role="group"
    aria-roledescription="carousel"
    aria-label={`${name} photos`}
  >
    {/* ── Viewport ── */}
    <div class="carousel-frame">
      <div class="carousel-track" data-track tabindex="0">
        {slides.map((photo, i) => (
          <figure class="carousel-slide" data-slide role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
            <img
              src={photo.image!.asset!.url + '?w=1600&h=1000&fit=crop&auto=format'}
              alt={photo.caption ?? `${name} — photo ${i + 1}`}
              class="carousel-img"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
            {photo.caption && (
              <figcaption class="carousel-caption">{photo.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>

      {multiple && (
        <>
          <button type="button" class="carousel-arrow carousel-prev" data-prev aria-label="Previous photo">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="carousel-arrow carousel-next" data-next aria-label="Next photo">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class="carousel-counter" aria-live="polite">
            <span data-current>1</span> / {slides.length}
          </div>
        </>
      )}
    </div>

    {multiple && (
      <>
        {/* Dots — primary control on mobile */}
        <div class="carousel-dots" role="tablist" aria-label="Choose photo">
          {slides.map((_, i) => (
            <button
              type="button"
              class="carousel-dot"
              data-dot
              data-index={i}
              role="tab"
              aria-label={`Go to photo ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>

        {/* Thumbnails — primary control on desktop */}
        <div class="carousel-thumbs" data-thumbs>
          {slides.map((photo, i) => (
            <button
              type="button"
              class="carousel-thumb"
              data-dot
              data-index={i}
              aria-label={`Go to photo ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              <img
                src={photo.image!.asset!.url + '?w=200&h=150&fit=crop&auto=format'}
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </button>
          ))}
        </div>
      </>
    )}
  </div>
)}

<style>
  .project-carousel {
    --carousel-radius: 16px;
  }

  .carousel-frame {
    position: relative;
    border-radius: var(--carousel-radius);
    overflow: hidden;
    background: #f4f4f2;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    outline: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track:focus-visible {
    box-shadow: inset 0 0 0 3px #17b060;
  }

  .carousel-slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    margin: 0;
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 768px) {
    .carousel-slide {
      aspect-ratio: 16 / 10;
    }
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  .carousel-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 32px 16px 14px;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #ffffff;
    background: linear-gradient(to top, rgba(35, 31, 32, 0.72), rgba(35, 31, 32, 0));
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .carousel-caption {
      padding: 44px 22px 18px;
      font-size: 0.88rem;
    }
  }

  /* Arrows */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: #231f20;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(35, 31, 32, 0.18);
    transition: background 0.15s, color 0.15s, opacity 0.15s;
    z-index: 2;
  }
  @media (min-width: 768px) {
    .carousel-arrow {
      width: 44px;
      height: 44px;
    }
  }
  .carousel-arrow:hover {
    background: #ffffff;
    color: #17b060;
  }
  .carousel-arrow:focus-visible {
    outline: 3px solid #17b060;
    outline-offset: 2px;
  }
  .carousel-prev {
    left: 10px;
  }
  .carousel-next {
    right: 10px;
  }
  @media (min-width: 768px) {
    .carousel-prev {
      left: 16px;
    }
    .carousel-next {
      right: 16px;
    }
  }

  .carousel-counter {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 11px;
    border-radius: 999px;
    background: rgba(35, 31, 32, 0.55);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    z-index: 2;
  }

  /* Dots — mobile control */
  .carousel-dots {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }
  @media (min-width: 768px) {
    .carousel-dots {
      display: none;
    }
  }
  .carousel-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: #d6d3d1;
    cursor: pointer;
    transition: background 0.2s, width 0.2s;
  }
  .carousel-dot[aria-selected='true'] {
    background: #17b060;
    width: 22px;
  }
  .carousel-dot:focus-visible {
    outline: 2px solid #17b060;
    outline-offset: 3px;
  }

  /* Thumbnails — desktop control */
  .carousel-thumbs {
    display: none;
    gap: 8px;
    margin-top: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  @media (min-width: 768px) {
    .carousel-thumbs {
      display: flex;
    }
  }
  .carousel-thumb {
    flex: 0 0 84px;
    height: 63px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: #f4f4f2;
    cursor: pointer;
    opacity: 0.62;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .carousel-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .carousel-thumb:hover {
    opacity: 1;
  }
  .carousel-thumb[aria-selected='true'] {
    opacity: 1;
    border-color: #17b060;
  }
  .carousel-thumb:focus-visible {
    outline: 2px solid #17b060;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const thumbStrip = root.querySelector<HTMLElement>('[data-thumbs]');
    const counter = root.querySelector<HTMLElement>('[data-current]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (slides.length < 2) return;

    let index = 0;

    function goTo(i: number) {
      // Wrap around so the arrows never dead-end.
      const target = (i + slides.length) % slides.length;
      track!.scrollTo({ left: slides[target].offsetLeft - track!.offsetLeft, behavior: 'smooth' });
    }

    function setIndex(i: number) {
      if (i === index) return;
      index = i;
      if (counter) counter.textContent = String(i + 1);
      // Dots and thumbnails share this list, so match on the slide index they carry.
      dots.forEach(dot => dot.setAttribute('aria-selected', Number(dot.dataset.index) === i ? 'true' : 'false'));

      // Keep the active thumbnail in view on long strips.
      if (thumbStrip) {
        const activeThumb = thumbStrip.children[i] as HTMLElement | undefined;
        if (activeThumb) {
          const left = activeThumb.offsetLeft - thumbStrip.offsetWidth / 2 + activeThumb.offsetWidth / 2;
          thumbStrip.scrollTo({ left, behavior: 'smooth' });
        }
      }
    }

    // Derive the active slide from scroll position — covers swipes, arrows and dots alike.
    let raf = 0;
    track.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const center = track.scrollLeft + track.clientWidth / 2;
        let closest = 0;
        let best = Infinity;
        slides.forEach((slide, i) => {
          const dist = Math.abs(slide.offsetLeft - track.offsetLeft + slide.offsetWidth / 2 - center);
          if (dist < best) {
            best = dist;
            closest = i;
          }
        });
        setIndex(closest);
      });
    }, { passive: true });

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));

    dots.forEach(dot => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(index + 1);
      }
    });

    // Pointer drag for mouse users (touch already scrolls natively).
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      dragging = true;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.style.scrollBehavior = 'auto';
      track.style.cursor = 'grabbing';
    });
    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      e.preventDefault();
      track.scrollLeft = startScroll - (e.clientX - startX);
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.style.scrollBehavior = '';
      track.style.cursor = '';
      // Snap to whichever slide is nearest after the drag.
      goTo(index);
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointerleave', endDrag);
    track.addEventListener('pointercancel', endDrag);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
