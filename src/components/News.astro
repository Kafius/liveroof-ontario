---
// The 3 most recent posts from liveroof.com, fetched at build time and then
// refreshed in the browser on every page load (see the script below), so the
// section stays current without a redeploy.
import { fetchArticles } from '../lib/news';

const articles = await fetchArticles(3);
---

<section class="py-14 md:py-24">
  <div class="container">
    <div class="section-header">
      <span class="tag">What's New</span>
      <h2>Latest from LiveRoof</h2>
      <p>Research, case studies, and insights from the world's leading vegetated roof system.</p>
    </div>

    <div class="news-grid" data-news-grid data-news-limit="3" hidden={articles.length === 0}>
      {articles.map((a) => (
        <a href={a.link} target="_blank" rel="noopener noreferrer" class="news-card group block">
          <div class="h-[200px] overflow-hidden">
            <img src={a.image} alt={a.title} loading="lazy" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="news-card-body p-6">
            <div class="news-date">{a.date}</div>
            <h3 class="group-hover:text-blue transition-colors">{a.title}</h3>
            {a.excerpt && <p>{a.excerpt}</p>}
            <span class="news-read">Read Article →</span>
          </div>
        </a>
      ))}
    </div>

    {articles.length === 0 && (
      <div class="text-center py-16" data-news-fallback>
        <p class="text-text-muted">Unable to load articles. Visit <a href="/news" class="text-blue hover:underline">our news page</a> for the latest.</p>
      </div>
    )}
  </div>
</section>

<script>
  import { refreshNewsGrids } from '../lib/news';
  refreshNewsGrids();
</script>
