---
import PhoneReveal from './PhoneReveal.astro';
// Product and technical detail pages live on the LiveRoof Global site; only
// /products, /products/hydropavers and /technical exist locally. These mirror
// the Header dropdowns and route through the external-link interstitial.
const productLinks = [
  { label: 'All Products', href: '/products' },
  { label: 'Vegetated Roof Modules', href: 'https://liveroof.com/products/modules/' },
  { label: 'RoofEdge', href: 'https://liveroof.com/products/roofedge/' },
  { label: 'RoofStone', href: 'https://liveroof.com/products/roofstone/' },
  { label: 'WindDisc', href: 'https://liveroof.com/products/winddisc/' },
  { label: 'PipeRunner', href: 'https://liveroof.com/products/piperunner/' },
  { label: 'RoofBlue', href: 'https://liveroof.com/products/roofblue/' },
  { label: 'Plants', href: 'https://liveroof.com/products/plants/' },
  { label: 'Soil', href: 'https://liveroof.com/products/soil/' },
  { label: 'Hydropavers', href: '/products/hydropavers' },
];
const technicalLinks = [
  { label: 'All Resources', href: '/technical' },
  { label: 'Design & Engineering', href: 'https://liveroof.com/technical/design/' },
  { label: 'Detail Drawings', href: 'https://liveroof.com/technical/detail-drawings/' },
  { label: 'Installation Guide', href: 'https://liveroof.com/technical/installation/' },
  { label: 'LEED Resources', href: 'https://liveroof.com/technical/leed/' },
  { label: 'Spec Writer', href: 'https://liveroof.com/technical/spec-writer/' },
  { label: 'Continuing Education', href: 'https://liveroof.com/technical/continuing-education/' },
  { label: 'Maintenance & Ops', href: 'https://liveroof.com/technical/maintenance/' },
  { label: 'Videos', href: 'https://liveroof.com/videos/' },
];
const companyLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Benefits', href: '/benefits' },
  { label: 'News', href: '/news' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-dark text-white/60 pt-16">
  <div class="container">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-8 lg:gap-12 pb-12">
      <div>
        <a href="/" class="inline-flex items-center">
          <img
            src="/logo-no-tagline.svg"
            alt="LiveRoof Ontario"
            class="h-[52px] w-auto object-contain"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
          />
          <div class="hidden font-serif text-2xl">
            <span class="text-blue">Live</span><span class="text-green">Roof</span>
          </div>
        </a>
        <div class="text-white/40 text-[0.6rem] tracking-wide uppercase font-medium mt-2">
          The Proof is in the Roof
        </div>
        <p class="text-[0.85rem] leading-relaxed mt-5 text-white/50 max-w-[280px]">
          LiveRoof vegetated roof systems deliver instant maturity, natural beauty, and decades of proven
          performance — locally grown, locally supported.
        </p>
        <div class="mt-5 text-[0.8rem] leading-[1.7] text-white/[0.45]">
          LiveRoof Ontario<br />
          23078 Adelaide Road<br />
          Mt. Brydges, ON, N0L 1W0<br />
          <PhoneReveal number="5196715777" />
          <br />
          kees@liveroofontario.ca
        </div>
      </div>
      <div class="footer-col">
        <h5>Products</h5>
        <ul>
          {productLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Technical</h5>
        <ul>
          {technicalLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Company</h5>
        <ul>
          {companyLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="border-t border-white/[0.08] py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/30">
      <span>&copy; 2025 LiveRoof Ontario. All rights reserved.</span>
      <div class="flex gap-5">
        <a href="/privacy" class="text-white/30 hover:text-green transition-colors">Privacy Policy</a>
        <a href="/faq" class="text-white/30 hover:text-green transition-colors">FAQ's</a>
        <p>Website by <a href="https://thelinovagroup.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">The Linova Group</a></p>
      </div>
    </div>
  </div>
</footer>
