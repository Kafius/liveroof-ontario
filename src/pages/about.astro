---
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/AboutHero.astro';
import { breadcrumbSchema } from '../lib/structuredData';
import AboutMission from '../components/AboutMission.astro';
import AboutStats from '../components/AboutStats.astro';
import AboutInspiration from '../components/AboutInspiration.astro';
import CtaBanner from '../components/CtaBanner.astro';

// AboutHero has no breadcrumb trail of its own, so the JSON-LD is declared here.
const breadcrumbJsonLd = JSON.stringify(
  breadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'About Us' }]),
);
---

<Layout
  title="About Us – LiveRoof Vegetated Roof Systems"
  description="Canada's largest producer of pre-vegetated modular green roof systems — over 75 acres of modules grown on our southwestern Ontario farm and delivered to 900+ projects."
  image="/images/Green_Roof_Fields.JPG"
>
  <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />

  <AboutHero />
  <AboutStats />
  <AboutMission />
  <AboutInspiration />
  <CtaBanner />
</Layout>
