---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { fetchArticles } from '../lib/news';

// Posts are fetched at build time and refreshed in the browser on every page
// load (see the script below), so the listing stays current without a redeploy.
const articles = await fetchArticles(9);
---

<Layout title="News – LiveRoof Vegetated Roof Systems">
  <TopBar />
  <Header />

  <PageHero
    eyebrow="News"
    title="Latest from"
    highlight="LiveRoof"
    subtitle="Research, case studies, and insights from the world's leading vegetated roof system."
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'News' },
    ]}
  />

  <section class="py-14 md:py-24 bg-white">
    <div class="container">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7"
        data-news-grid
        data-news-limit="9"
        hidden={articles.length === 0}
      >
        {articles.map((article) => (
          <a href={article.link} target="_blank" rel="noopener noreferrer" class="news-card group block">
            <div class="h-[200px] overflow-hidden">
              <img src={article.image} alt={article.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="news-card-body p-6">
              <div class="news-date">{article.date}</div>
              <h4 class="group-hover:text-blue transition-colors">{article.title}</h4>
              {article.excerpt && <p>{article.excerpt}</p>}
              <span class="news-read">Read Article &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      {articles.length === 0 && (
        <div class="text-center py-16" data-news-fallback>
          <p class="text-text-muted">Unable to load articles. Visit <a href="https://liveroof.com/news/" target="_blank" rel="noopener noreferrer" class="text-blue hover:underline">liveroof.com/news</a> for the latest.</p>
        </div>
      )}
    </div>
  </section>

  <CtaBanner />
  <Footer />
</Layout>

<script>
  import { refreshNewsGrids } from '../lib/news';
  refreshNewsGrids();
</script>
